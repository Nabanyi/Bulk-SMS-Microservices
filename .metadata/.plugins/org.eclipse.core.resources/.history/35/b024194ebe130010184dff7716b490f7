spring.application.name=ApiGateway
server.port=8010
eureka.client.service-url.defaultZone=http://localhost:8761/eureka

spring.main.web-application-type=reactive

spring.cloud.gateway.routes[0].id=Contact
spring.cloud.gateway.routes[0].uri=http://localhost:8040
spring.cloud.gateway.routes[0].predicates[0]=Path=/contact/**

spring.cloud.gateway.routes[1].id=Campaign
spring.cloud.gateway.routes[1].uri=http://localhost:8030
spring.cloud.gateway.routes[1].predicates[0]=Path=/campaign/**

# Database configuration for test database
spring.datasource.url=jdbc:mysql://localhost:3308/sms
spring.datasource.username=root
spring.datasource.password=

# Hibernate configuration
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQL8Dialect
