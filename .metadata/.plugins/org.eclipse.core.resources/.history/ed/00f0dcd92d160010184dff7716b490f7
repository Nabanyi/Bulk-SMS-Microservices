spring.application.name=Contact
server.port=8040
eureka.client.register-with-eureka: true
eureka.client.fetch-registry: true
eureka.client.service-url.defaultZone=http://localhost:8761/eureka

#server.address=0.0.0.0
#eureka.instance.prefer-ip-address=true

# Database configuration for test database
spring.datasource.url=jdbc:mysql://localhost:3308/sms
spring.datasource.username=root
spring.datasource.password=

# Hibernate configuration
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQL8Dialect

# add to admin dashboard for metrics and stats
spring.boot.admin.client.url=http://localhost:8020
management.endpoints.web.exposure.include=*
management.endpoint.health.show-details=always

#For sorting endpoints alphabetically
springdoc.swagger-ui.operationsSorter=alpha
springdoc.swagger-ui.tagsSorter=alpha
springdoc.api-docs.path=/contact-api
springdoc.swagger-ui.path=/api.html