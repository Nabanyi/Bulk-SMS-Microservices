spring.application.name=ApiGateway
server.port=8010
eureka.client.service-url.defaultZone=http://localhost:8761/eureka

spring.main.web-application-type=reactive

# Route to Contact Service
spring.cloud.gateway.routes[0].id=contact-service
spring.cloud.gateway.routes[0].uri=http://localhost:8040
spring.cloud.gateway.routes[0].predicates[0]=Path=/contact/**
spring.cloud.gateway.routes[0].filters[0]=RewritePath=/contact/(?<path>.*), /${path}

# Route to Campaign Service
spring.cloud.gateway.routes[1].id=campaign-service
spring.cloud.gateway.routes[1].uri=http://localhost:8030
spring.cloud.gateway.routes[1].predicates[0]=Path=/campaign/**
spring.cloud.gateway.routes[1].filters[0]=RewritePath=/campaign/(?<path>.*), /${path}

# Enable service discovery for dynamic routing
spring.cloud.discovery.enabled=true

#consolidate all docs for all services
springdoc.swagger-ui.enabled=true
springdoc.swagger-ui.urls[0].name=Contact Service
springdoc.swagger-ui.urls[0].url=http://localhost:8040/v3/api-docs
springdoc.swagger-ui.urls[1].name=Campaign Service
springdoc.swagger-ui.urls[1].url=http://localhost:8030/v3/api-docs